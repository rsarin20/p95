# ─── Required ──────────────────────────────────────────────────────────────
# Public URL of the site (no trailing slash). Used for OAuth callbacks & invite links.
NEXTAUTH_URL=https://walktober.example.com
# Random secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Postgres connection string (Neon / Supabase / any Postgres). Tables are created automatically.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ─── Sign-in providers (each button appears only when its keys are set) ───
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
#   Redirect URI: https://<domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: developers.facebook.com → Create App → Facebook Login
#   Redirect URI: https://<domain>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple: developer.apple.com → Identifiers → Services ID (= APPLE_ID) with Sign in with Apple
#   Return URL: https://<domain>/api/auth/callback/apple
#   Keys → create a key with Sign in with Apple → download .p8
APPLE_ID=com.example.walktober.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 contents; literal "\n" sequences are fine.
APPLE_PRIVATE_KEY=

# ─── Step connectors (optional; manual entry + Apple Health Shortcut always work) ─
# Google Health API (successor to Google Fit). Reuses the Google OAuth client above;
# add redirect URI https://<domain>/api/connect/google/callback and enable the API.
GOOGLE_HEALTH_ENABLED=false
# Garmin Connect Developer Program (Health API). Requires Garmin approval.
#   Redirect URI: https://<domain>/api/connect/garmin/callback
#   Push endpoint (Dailies + Deregistrations): https://<domain>/api/webhooks/garmin
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Protects the nightly Google sync (Vercel Cron sends it automatically).
CRON_SECRET=

# ─── Challenge settings (defaults shown) ──────────────────────────────────
CHALLENGE_START=2026-10-01
CHALLENGE_END=2026-10-31
TEAM_MAX_MEMBERS=10

# ─── Local testing only — never enable in production ──────────────────────
# ALLOW_DEMO_LOGIN=true
